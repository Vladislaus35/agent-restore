{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Restore",
  "version": "1.0.0",
  "identifier": "org.agentrestore.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Restore",
        "width": 1400,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first checkpoint and recovery system for AI coding tools.",
    "longDescription": "Agent Restore is a universal, local-first checkpoint and recovery desktop application for developers working with AI coding agents.",
    "copyright": "Copyright (c) 2026 Vladislaus (MIT License)",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English", "Turkish"],
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
